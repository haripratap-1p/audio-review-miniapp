# Copy to ~/.config/review-app/review.env (chmod 600). Names only here; never commit real values.
TG_TOKEN=
TG_CHAT=
TG_COST_CHAT=
POST_FROM=2026-10-28
REVIEW_HOME=/home/thor02/SanjAI/audio-inference
RESULTS_BASE=/home/thor02/SanjAI/audio-inference/live_results
REVIEW_DB=/home/thor02/SanjAI/audio-inference/reviews.db
REVIEW_PORT=8787
# AI judge (review-judge.timer): comma-separated Gemini keys, rotated on quota
GEMINI_API_KEYS=
# optional, uncomment to override the defaults (an empty value is not a default)
#JUDGE_MODEL=
#JUDGE_DAILY_CAP=
#JUDGE_PRICE_IN=
#JUDGE_PRICE_OUT=
# false = stop posting that type to the group; the app then shows only what was already posted
CALLS=true
INSTORE=true
# offline alerts in the client group (defaults shown); the phone is checked while CALLS is on, the Jetson while INSTORE is on
#PHONE_ADDR=100.64.0.166:8022
#JETSON_ADDR=100.64.0.82:22
#ALERT_TAG=@Nikhil_mirajkar @Royjpr
# chat for the offline alerts; empty = the client group (TG_CHAT)
#ALERT_CHAT=
